<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GameLibraryApp.Views"
    x:Class="GameLibraryApp.AppShell">

    <TabBar>

        <ShellContent
            Title="Games"
            ContentTemplate="{DataTemplate views:GamesPage}"
            Route="GamesPage" />

        <ShellContent
            Title="Wishlist"
            ContentTemplate="{DataTemplate views:WishlistPage}"
            Route="WishlistPage" />

    </TabBar>

</Shell>