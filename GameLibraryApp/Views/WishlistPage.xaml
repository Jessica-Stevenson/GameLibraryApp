<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameLibraryApp.Views.WishlistPage"
             Title="Wishlist">

    <VerticalStackLayout Padding="20"
                         Spacing="15">

        <Label
            Text="My Wishlist"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <CollectionView x:Name="WishlistCollectionView">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="#ccc"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10"
                            Margin="5">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Title}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Genre}" />

                            <Label
                                Text="{Binding Platform}" />

                            <Label
                                Text="{Binding Rating, StringFormat='Rating: {0}'}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>